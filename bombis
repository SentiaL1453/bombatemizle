    end)
    
    if success and pos then
        return pos
    end
    
    return nil
end

local function SafeMouseMoveAbs(x: number, y: number): boolean
    local success: boolean = Pcall(function()
        mousemoveabs(x, y)
    end)
    
    return success
end

local function SafeMouse1Click(): boolean
