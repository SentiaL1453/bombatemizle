local Signal = {}
Signal.__index = Signal

function Signal.new()
    return setmetatable({
        _listeners = {},
        _waiters = {},
    }, Signal)
end

function Signal:connect(fn)
    local node = { fn = fn, alive = true }
    table.insert(self._listeners, node)
    local conn = {}
    function conn:disconnect()
        node.alive = false
        node.fn = nil
    end
    return conn
end

function Signal:fire(...)
    for i = #self._listeners, 1, -1 do
        local n = self._listeners[i]
        if not n.alive then
            table.remove(self._listeners, i)
        else
            task.spawn(n.fn, ...)
        end
    end
    if #self._waiters > 0 then
        local snapshot = self._waiters
        self._waiters = {}
        for _, co in snapshot do
            task.spawn(co, ...)
        end
    end
end

function Signal:wait()
    table.insert(self._waiters, coroutine.running())
    return coroutine.yield()
end

